{
  "name": "@apollo-code/capability-contract",
  "version": "0.1.0",
  "private": true,
  "description": "ABI-00 capability contract bootstrap primitives: Canonical JSON V1, domain-separated digests, and strict Ed25519 verification (§19a). Verifier-only; no signing material, no runtime wiring.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authority": {
      "types": "./dist/authority.d.ts",
      "default": "./dist/authority.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-esm-specifiers.mjs dist",
    "test": "vitest run --passWithNoTests --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
