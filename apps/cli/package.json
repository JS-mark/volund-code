{
  "name": "volund-cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "volund": "dist/volund.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "build:standalone": "node ../../scripts/build-standalone.mjs",
    "test": "vitest run --passWithNoTests --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@volund/auth": "workspace:*",
    "@volund/config": "workspace:*",
    "@volund/context": "workspace:*",
    "@volund/core": "workspace:*",
    "@volund/mcp-client": "workspace:*",
    "@volund/native-bridge": "workspace:*",
    "@volund/permission": "workspace:*",
    "@volund/plugin-runtime": "workspace:*",
    "@volund/plugin-sdk": "workspace:*",
    "@volund/provider-anthropic": "workspace:*",
    "@volund/provider-gemini": "workspace:*",
    "@volund/provider-kit": "workspace:*",
    "@volund/provider-ollama": "workspace:*",
    "@volund/provider-openai": "workspace:*",
    "@volund/router": "workspace:*",
    "@volund/shared": "workspace:*",
    "@volund/skills-runtime": "workspace:*",
    "@volund/storage": "workspace:*",
    "@volund/subagent": "workspace:*",
    "@volund/telemetry": "workspace:*",
    "@volund/tool-kit": "workspace:*",
    "@volund/tools": "workspace:*",
    "@volund/ui": "workspace:*",
    "citty": "catalog:",
    "react-devtools-core": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
