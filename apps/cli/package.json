{
  "name": "apollo-code",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "apollo": "dist/apollo.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "build:standalone": "node ../../scripts/build-standalone.mjs",
    "test": "vitest run --passWithNoTests --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo-code/auth": "workspace:*",
    "@apollo-code/config": "workspace:*",
    "@apollo-code/context": "workspace:*",
    "@apollo-code/core": "workspace:*",
    "@apollo-code/mcp-client": "workspace:*",
    "@apollo-code/native-bridge": "workspace:*",
    "@apollo-code/permission": "workspace:*",
    "@apollo-code/plugin-runtime": "workspace:*",
    "@apollo-code/plugin-sdk": "workspace:*",
    "@apollo-code/provider-anthropic": "workspace:*",
    "@apollo-code/provider-gemini": "workspace:*",
    "@apollo-code/provider-kit": "workspace:*",
    "@apollo-code/provider-ollama": "workspace:*",
    "@apollo-code/provider-openai": "workspace:*",
    "@apollo-code/router": "workspace:*",
    "@apollo-code/shared": "workspace:*",
    "@apollo-code/skills-runtime": "workspace:*",
    "@apollo-code/storage": "workspace:*",
    "@apollo-code/subagent": "workspace:*",
    "@apollo-code/telemetry": "workspace:*",
    "@apollo-code/tool-kit": "workspace:*",
    "@apollo-code/tools": "workspace:*",
    "@apollo-code/ui": "workspace:*",
    "citty": "catalog:",
    "react-devtools-core": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
