{
  "name": "volund-code",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:standalone": "pnpm --filter volund-cli build:standalone",
    "docs:api": "pnpm --filter @volund/docs exec typedoc --options ../../typedoc.json",
    "release:status": "changeset status",
    "release:evidence:generate": "node scripts/generate-l4-evidence-matrix.mjs --input docs/releases/l4-evidence.json --output docs/releases/L4-EVIDENCE-MATRIX.md",
    "release:evidence:check": "node scripts/generate-l4-evidence-matrix.mjs --input docs/releases/l4-evidence.json --output docs/releases/L4-EVIDENCE-MATRIX.md --check",
    "release:evidence:assert": "node scripts/generate-l4-evidence-matrix.mjs --input docs/releases/l4-evidence.json --output docs/releases/L4-EVIDENCE-MATRIX.md --check --assert-release",
    "release:channels:generate": "node scripts/generate-channel-manifests.mjs --input docs/releases/channel-dry-run.json --output docs/releases/channel-dry-run",
    "release:channels:check": "node scripts/generate-channel-manifests.mjs --input docs/releases/channel-dry-run.json --output docs/releases/channel-dry-run --check",
    "release:update:check": "node scripts/verify-update-manifest.mjs --input docs/releases/update-dry-run/manifest.json",
    "release:windows:dry-run": "node scripts/verify-windows-release-evidence.mjs --input docs/releases/windows-signing-fixture.json",
    "release:version:dry-run": "changeset version --snapshot dry-run",
    "release": "changeset publish",
    "check:event-schemas": "node --test scripts/verify-event-schemas.test.mjs && node scripts/verify-event-schemas.mjs",
    "check:typescript-config": "node --test scripts/verify-typescript-config.test.mjs scripts/rewrite-esm-specifiers.test.mjs && node scripts/verify-typescript-config.mjs",
    "format": "oxfmt apps packages scripts .github/workflows/typescript.yml package.json tsconfig.base.json turbo.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check apps packages scripts .github/workflows/typescript.yml package.json tsconfig.base.json turbo.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint . --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix --report-unused-disable-directives",
    "test": "turbo run test && pnpm --filter volund-cli build && node --test scripts/build-standalone.test.mjs scripts/generate-channel-manifests.test.mjs scripts/generate-l4-evidence-matrix.test.mjs scripts/l1-local-e2e.test.mjs scripts/pack-standalone-npm.test.mjs scripts/verify-changesets-release-plan.test.mjs scripts/verify-config-docs.test.mjs scripts/verify-error-codes.test.mjs scripts/verify-event-schemas.test.mjs scripts/verify-l1-docs.test.mjs scripts/verify-l2-release.test.mjs scripts/verify-native-platforms.test.mjs scripts/verify-plugin-runtime-packlist.test.mjs scripts/verify-update-manifest.test.mjs scripts/verify-windows-release-evidence.test.mjs",
    "test:l1-local-e2e": "pnpm --filter volund-cli build && node --test scripts/l1-local-e2e.test.mjs",
    "typecheck": "turbo run typecheck",
    "verify:config-docs": "node scripts/verify-config-docs.mjs",
    "verify:error-codes": "node scripts/verify-error-codes.mjs",
    "pack:standalone": "node scripts/pack-standalone-npm.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
