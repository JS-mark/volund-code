# ---- volund 网关部署配置（deploy/gateway/.env） ----

# ── 上游模型（可配置 OpenAI 兼容上游）────────────────────────────────
# provider 选择走 volund config.toml（挂载到 /data 或构建期写入）：
#   [provider.openai] baseUrl = "https://your-upstream/v1"
# 凭据用 env 注入（AuthManager 第三层）：OPENAI_API_KEY / ANTHROPIC_API_KEY 等。
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── 网关自身 ─────────────────────────────────────────────────────────
# OAuth 客户端（JSON 数组）。不设置时首启生成 bootstrap client 并落盘
# /data/gateway/clients.json（secret 只在启动日志里出现一次）。
# GATEWAY_CLIENTS=[{"id":"ci-bot","secret":"换成至少32位的随机串","scopes":["chat","sessions"]}]

# JWT 签名密钥；不设置则生成随机密钥落盘 /data/gateway/token-key（0600，跨重启复用）。
# GATEWAY_TOKEN_SECRET=

# 会话权限模式：ask（全部走审批卡）| auto（低风险自动放行，默认）| full（全放行）
# 容器内没有 syscall 沙箱（volund-sandbox 原生模块不进镜像）——容器本身就是隔离边界，
# 生产建议 auto 或 full；ask 模式下提权命令需有 WS 客户端在线审批（超时自动 deny）。
GATEWAY_PERMISSION_MODE=auto

# GATEWAY_TOKEN_TTL_SECONDS=3600
# GATEWAY_PERMISSION_TIMEOUT_MS=120000
# GATEWAY_QUEUE_TIMEOUT_MS=600000
# GATEWAY_RATE_LIMIT_RPM=600
# GATEWAY_TOKEN_RATE_LIMIT_RPM=30
# GATEWAY_CORS_ORIGINS=https://your-webapp.example
# GATEWAY_DEFAULT_PROVIDER=openai
