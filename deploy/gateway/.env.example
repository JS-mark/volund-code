# ---- volund 远程网关（relay）部署配置（deploy/gateway/.env） ----
# 网关是纯中转进程：不挂会话、不跑模型——上游 provider/权限/模型别名都在
# 本机 volund 侧（桌面 config.toml），这里只配网关自身。

# ── 必填（生产） ─────────────────────────────────────────────────────
# 配对二维码/移动站入口的公网基地址（缺省按请求 Host 推断；网关直曝时配 http://<host>:8788，
# 有前置 TLS 反代/CDN 时配对外可见的 https 基地址）
GATEWAY_PUBLIC_URL=http://<host>:8788

# ── OAuth 客户端 ─────────────────────────────────────────────────────
# 不设置时首启生成 bootstrap client——明文只在启动日志出现一次，
# /data/gateway/clients.json 里只存其 SHA-256 哈希（老的明文文件自动迁移）。
# 本机 uplink 接入需要 scopes 含 uplink（bootstrap 客户端默认带）。
# 多机自助接入：clients.json 来源（bootstrap/文件）时注册面开放——已接入机器
# `volund remote enroll` 铸注册码，新机器 `volund remote connect --code` 核销。
# 设置了 GATEWAY_CLIENTS 则注册面关闭（env 是唯一事实源，只读）。
# GATEWAY_CLIENTS=[{"id":"volund-xxx","secret":"xxxxx","scopes":["uplink","chat","sessions"]}]

# JWT 签名密钥；不设置则生成随机密钥落盘 /data/gateway/token-key（0600，跨重启复用）。
# GATEWAY_TOKEN_SECRET=

# ── 可调项（默认值见 README 环境变量表） ─────────────────────────────
# GATEWAY_TOKEN_TTL_SECONDS=3600
# GATEWAY_PERMISSION_TIMEOUT_MS=120000
# GATEWAY_QUEUE_TIMEOUT_MS=600000
# GATEWAY_MAX_TURN_HOLD_MS=1800000
# GATEWAY_RATE_LIMIT_RPM=600
# GATEWAY_TOKEN_RATE_LIMIT_RPM=30
# GATEWAY_CORS_ORIGINS=
