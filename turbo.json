{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#check:typescript-config": {
      "outputs": []
    },
    "//#verify:config-docs": {
      "outputs": []
    },
    "//#verify:error-codes": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "//#verify:config-docs", "//#verify:error-codes"],
      "outputs": []
    },
    "@volund/docs#typecheck": {
      "dependsOn": ["build", "^build", "//#check:typescript-config"],
      "outputs": ["api/**"]
    },
    "@volund/docs#test": {
      "dependsOn": [
        "^build",
        "@volund/docs#typecheck",
        "//#verify:config-docs",
        "//#verify:error-codes"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build", "^build", "//#check:typescript-config"],
      "outputs": []
    }
  }
}
