{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volund-code.dev/schemas/l4-evidence-v1.json",
  "title": "Volund CLI L4 release evidence",
  "type": "object",
  "required": ["schemaVersion", "release", "generatedAt", "maxAgeDays", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "maxAgeDays": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["target", "tier", "environment", "checks"],
        "properties": {
          "target": { "type": "string" },
          "tier": { "enum": [1, 2, 3] },
          "environment": { "enum": ["native", "cross", "qemu", "real-hardware", "not-run"] },
          "checks": {
            "type": "object",
            "required": ["build", "native", "escape", "signing", "notarize"],
            "properties": {
              "build": { "$ref": "#/$defs/check" },
              "native": { "$ref": "#/$defs/check" },
              "escape": { "$ref": "#/$defs/check" },
              "signing": { "$ref": "#/$defs/check" },
              "notarize": { "$ref": "#/$defs/check" }
            },
            "additionalProperties": false
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": { "status": { "const": "not-run" }, "reason": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "sha", "timestamp", "source"],
          "properties": {
            "status": { "enum": ["pass", "fail"] },
            "sha": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" },
            "timestamp": { "type": "string", "format": "date-time" },
            "source": { "type": "string", "minLength": 1 },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
